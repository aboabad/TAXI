rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userDocExists() {
      return signedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function userRole() {
      return userDocExists()
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
        : 'user';
    }

    function isAdmin() {
      return signedIn() && userRole() == 'admin';
    }

    function isDriver() {
      return signedIn() && userRole() == 'driver';
    }

    function isRestaurantUser() {
      return signedIn() && userRole() == 'restaurant';
    }

    function restaurantOwnedByCurrentUser(restaurantData) {
      return signedIn() &&
        (restaurantData.ownerUid == request.auth.uid ||
         (request.auth.token.email != null &&
          restaurantData.ownerUsername == request.auth.token.email));
    }

    function ownsRestaurant(restaurantId) {
      return signedIn() &&
        exists(/databases/$(database)/documents/restaurants/$(restaurantId)) &&
        restaurantOwnedByCurrentUser(
          get(/databases/$(database)/documents/restaurants/$(restaurantId)).data
        );
    }

    match /users/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || isAdmin());

      allow create: if signedIn() &&
        (isAdmin() ||
          (request.auth.uid == userId &&
           request.resource.data.role == 'user'));

      allow update: if signedIn() &&
        (isAdmin() ||
          (request.auth.uid == userId &&
           request.resource.data.role == resource.data.role));

      allow delete: if isAdmin();
    }

    match /restaurants/{restaurantId} {
      allow read: if signedIn();
      allow create, delete: if isAdmin();
      allow update: if isAdmin() ||
        (isRestaurantUser() && restaurantOwnedByCurrentUser(resource.data));
    }

    match /menu_items/{itemId} {
      allow read: if signedIn();
      allow create: if isAdmin() || ownsRestaurant(request.resource.data.restaurantId);
      allow update, delete: if isAdmin() || ownsRestaurant(resource.data.restaurantId);
    }

    match /orders/{orderId} {
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;

      allow read: if signedIn() &&
        (isAdmin() ||
         resource.data.userId == request.auth.uid ||
         resource.data.driverId == request.auth.uid ||
         ownsRestaurant(resource.data.restaurantId) ||
         (isDriver() &&
          (resource.data.status == 'restaurantAccepted' ||
           resource.data.status == 'accepted' ||
           resource.data.status == 'onTheWay')));

      allow update: if signedIn() &&
        (isAdmin() ||
         resource.data.userId == request.auth.uid ||
         resource.data.driverId == request.auth.uid ||
         ownsRestaurant(resource.data.restaurantId) ||
         (isDriver() && resource.data.status == 'restaurantAccepted'));

      allow delete: if isAdmin();
    }

    match /driver_locations/{driverId} {
      allow read: if signedIn();
      allow create, update: if signedIn() &&
        (request.auth.uid == driverId || isAdmin());
      allow delete: if isAdmin() || (signedIn() && request.auth.uid == driverId);
    }

    match /app_settings/{documentId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /chats/{chatId} {
      allow read, create, update: if signedIn();
      allow delete: if isAdmin();

      match /messages/{messageId} {
        allow read: if signedIn();
        allow create: if signedIn() &&
          request.resource.data.senderId == request.auth.uid;
        allow update, delete: if signedIn() &&
          (resource.data.senderId == request.auth.uid || isAdmin());
      }
    }
  }
}
